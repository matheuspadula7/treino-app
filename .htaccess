# Arquivos que nao precisam ficar acessiveis pela web
<FilesMatch "^(schema\.sql|README\.md|DEPLOY\.md|\.gitignore)$">
  Require all denied
</FilesMatch>

Options -Indexes

# O navegador sempre confere se ha versao nova dos arquivos do app (evita celular preso em versao antiga)
<FilesMatch "\.(js|css|html|webmanifest)$">
  Header set Cache-Control "no-cache"
</FilesMatch>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>
